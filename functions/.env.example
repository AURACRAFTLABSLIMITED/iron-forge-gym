# Created by AURA CRAFT LABS LIMITED.
# Copy to functions/.env for local emulator testing only.
# For production deployments, store secrets using Firebase Secrets Manager:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Firestore database ID (leave as (default) for standard Firestore, or set named database ID)
FIRESTORE_DATABASE_ID=(default)

# CUSTOMIZE: Fallback gym details used in email notifications if settings/site has not been saved yet
GYM_NAME=IRONFORGE ATHLETICS
GYM_ACCENT_COLOR=#A4D614
GYM_OWNER_EMAIL=owner@yourgym.com
GYM_SITE_URL=https://ironforge-gym-4a363.web.app

# Local emulator Stripe test keys (NEVER commit real live keys!)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Safepay card gateway (paymentProvider = "custom"). Keys go in Secret Manager, NOT here:
#   firebase functions:secrets:set SAFEPAY_API_KEY
#   firebase functions:secrets:set SAFEPAY_V1_SECRET
#   firebase functions:secrets:set SAFEPAY_WEBHOOK_SECRET
# Use sandbox while testing, production once the client's merchant account is approved.
SAFEPAY_ENV=sandbox
SAFEPAY_AMOUNT_MULTIPLIER=1
